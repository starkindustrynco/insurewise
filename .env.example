# Copy this file to .env.local for local development, or add the same
# variables in the Render dashboard (Environment). Never commit real keys.

# Google Gemini API key (https://aistudio.google.com/apikey).
# Without it, InsureWise runs on its built-in sample engine.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Gemini model id. Defaults to gemini-flash-latest.
# AI_MODEL=gemini-flash-latest

# Optional: set to false to force the sample engine even when a key is set.
# AI_ENABLED=true

# Optional: AI requests allowed per client per minute (default 20).
# AI_RATE_LIMIT_PER_MINUTE=20

# Optional: how hard Gemini thinks when reading a policy: minimal, low (default), medium, high.
# Lower is faster; higher can be more careful with long wordings.
# AI_READ_THINKING=low

# Optional: show provider error details in API responses outside development.
# AI_DEBUG_ERRORS=false
